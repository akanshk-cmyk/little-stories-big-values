# Set these as server environment variables; never put keys in browser code.
# New router settings are accepted but do not switch the existing live app path.
AI_PROVIDER_MODE=auto
GROQ_API_KEY=
GROQ_MODEL=
GROQ_REVIEW_MODEL=
NEBIUS_API_KEY=
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# Optional separate reviewer model. Uses a separate prompt/call even if identical.
NEBIUS_REVIEW_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional explicit browser path for local PDF rendering.
CHROME_PATH=

# LlamaParse adapter exists offline; managed retrieval pending. Disabled by default.
# Presence of settings does NOT grant upload permission or paid-call approval.
LLAMACLOUD_ENABLED=false
LLAMA_CLOUD_API_KEY=
LLAMACLOUD_ORGANIZATION_ID=
LLAMACLOUD_PROJECT_ID=
LLAMACLOUD_INDEX_ID=
# Confirm the account's API generation before selecting v1 or v2.
LLAMACLOUD_API_GENERATION=
LLAMACLOUD_REGION=us
LLAMACLOUD_CONNECT_SECONDS=10
LLAMACLOUD_READ_SECONDS=60
